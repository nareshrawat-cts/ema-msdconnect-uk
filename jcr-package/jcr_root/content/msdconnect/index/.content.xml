        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="cards-promo" name="Cards Promo">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card Promo" model="card-promo" modelFields="[image,imageAlt,text]" image="https://main--ema-msdconnect-uk--nareshrawat-cts.aem.page/media_1ebac8c944fc18dcb1bb4c9b6762489e452799de6.jpg#width=1600&amp;height=1067" imageAlt="MSD in the UK" text="&lt;p&gt;&lt;h1&gt;&lt;a href&#x3D;&quot;https://www.msd-uk.com/&quot;&gt;MSD in the UK&lt;/a&gt;&lt;/h1&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card Promo" model="card-promo" modelFields="[image,imageAlt,text]" text="&lt;p&gt;&lt;h2&gt;Healthcare Professional Resources&lt;/h2&gt;&lt;/p&gt;&lt;p&gt;This section contains training and resources, materials and promotional information on MSD products for UK healthcare professionals only&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.msdconnect.co.uk/hcp-resources/&quot;&gt;View our resources&lt;/a&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card Promo" model="card-promo" modelFields="[image,imageAlt,text]" text="&lt;p&gt;&lt;h2&gt;About us&lt;/h2&gt;&lt;/p&gt;&lt;p&gt;Here in the UK, we’re helping to transform the lives of millions of patients and populations by providing innovative medicines, vaccines and services, through our partnerships with the NHS and the work of the inspiring people who make up our company&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.msd-uk.com/company-overview/&quot;&gt;Learn more about us&lt;/a&gt;&lt;/p&gt;"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card Promo" model="card-promo" modelFields="[image,imageAlt,text]" image="https://main--ema-msdconnect-uk--nareshrawat-cts.aem.page/media_13fc653514a5987438367f1004c49c5c5a4b3dc0d.jpg#width=1600&amp;height=1067" imageAlt="Our PurposeWe use the power of leading-edge science to save and improve lives around the world" text="&lt;p&gt;&lt;h2&gt;&lt;a href&#x3D;&quot;https://www.msd-uk.com/&quot;&gt;Our Purpose&lt;/a&gt;We use the power of leading-edge science to save and improve lives around the world&lt;/h2&gt;&lt;/p&gt;"></item_3>
        </block>
