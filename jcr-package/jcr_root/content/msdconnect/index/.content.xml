              <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Guided by Our Values" titleType="h3"/>
              <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Our employees are united by four values that represent
                    who we are and how we work together:&lt;br&gt;
                    patients first; respect for people; ethics and integrity;
                    and innovation and scientific excellence&lt;/p&gt;"/>
